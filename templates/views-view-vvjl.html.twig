{#
/**
 * @file
 * Default theme implementation for VVJL: Views Vanilla JavaScript Lightbox.
 *
 * Outer element is `<vvjl-lightbox>` (custom element from v2.0).
 * Behavior is encapsulated in VvjlLightboxElement which extends
 * vvj_core's VvjElementBase. The custom element keeps every v1 CSS
 * class on its `class` attribute (`.vvjl`, `.vvjl-NN`) so theme
 * overrides targeting `.vvjl` continue to work, only the tag name
 * changed from `<div>` to `<vvjl-lightbox>`.
 *
 * Available variables (from preprocess_views_view_vvjl):
 *   - options: flattened style plugin options
 *   - rows: list of row render arrays
 *   - attributes: the wrapper attribute object
 *   - background_rgb: pre-computed rgba() string for the overlay
 *   - settings: a subset of options for JS hookup
 */
#}
{% set unique_id = options.unique_id %}
{% set vvjl_id = 'vvjl-' ~ unique_id %}
{% set lightbox_inner_id = 'vvjl-inner-' ~ unique_id %}
{% set grid_gap = options.grid_image_gap %}
{% set box_width = options.grid_image_width %}

{% set style_attributes = [] %}
{% if box_width > 0 %}
  {% set style_attributes = style_attributes|merge(['--box-width: ' ~ box_width]) %}
{% endif %}
{% if grid_gap > 0 %}
  {% set style_attributes = style_attributes|merge(['--grid-gap: ' ~ grid_gap]) %}
{% endif %}
{% set style_string = style_attributes ? style_attributes|join('; ') : '' %}

{% set classes = [
  'vvjl',
  vvjl_id,
] %}

{% set total_slides = rows|length %}

{# A Pattern chosen in the style settings (vvj_patterns enabled). #}
{% set vvj_pattern = options.vvj_pattern_active|default('') %}
{% set vvj_pattern_label = options.vvj_pattern_label|default('') %}
{% set vvj_features = options.vvj_pattern_features|default([]) %}
{% set vvjl_rail = '' %}
{% if vvj_pattern %}
  {% set vvjl_rail = 'rail_thumbs' in vvj_features ? 'thumbs' : ('rail_segments' in vvj_features ? 'segments' : ('rail_numbers' in vvj_features ? 'numbers' : '')) %}
  {% set classes = classes|merge(['vvj-pattern', vvj_pattern, 'morph' in vvj_features ? 'vvjl-morph' : '']) %}
{% endif %}
{% set vvjl_arrows = 'arrow_icons' in vvj_features %}

{# One name source: the heading. A Pattern's label replaces the default text. #}
<vvjl-lightbox {{ attributes.addClass(classes).setAttribute('id', vvjl_id) }} role="region" aria-labelledby="{{ vvjl_id }}-heading">
  <h2 id="{{ vvjl_id }}-heading" class="visually-hidden">{{ vvj_pattern and vvj_pattern_label ? vvj_pattern_label : 'Image Grid'|t }}</h2>
  <div id="{{ lightbox_inner_id }}" class="vvjl-inner" {% if style_string %}style="{{ style_string }}"{% endif %}>

    <div class="lightbox-modal" aria-hidden="true" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="{{ vvjl_id }}-lightbox-heading"{% if vvj_pattern %} tabindex="-1"{% endif %}>
      <h2 id="{{ vvjl_id }}-lightbox-heading" class="visually-hidden">{{ 'Image Grid Lightbox'|t }}</h2>
      {% if vvj_pattern %}
      <button type="button" class="button modal-close control-btn">
        {{ include('@vvjl/svg/vvjl-pattern-close.svg') }}<span class="vvjl-btn-text">{{ 'Close'|t }}</span>
      </button>

      <div class="lightbox-counter" aria-live="polite">
        <span id="{{ vvjl_id }}-current" class="current-image">1</span><span class="vvjl-of"><span class="vvjl-of-slash"> / </span><span class="vvjl-of-word">{{ 'of'|t }}</span></span><span class="total-images">{{ total_slides }}</span>
      </div>
      {% else %}
      <button class="button modal-close control-btn">
        <span class="visually-hidden">{{ 'Close Grid'|t }}</span>
        {{ include('@vvjl/svg/svg-close.svg') }}
      </button>

      <div class="lightbox-counter">
        <span id="{{ vvjl_id }}-current" class="current-image">1</span><span> / </span><span class="total-images">{{ total_slides }}</span>
      </div>
      {% endif %}

      <div class="lightbox-modal-content">
        {# Content injected by VvjlLightboxElement on row click. #}
      </div>
      {% if vvj_pattern %}
      <button type="button" class="button modal-prev control-btn">
        {{ include(vvjl_arrows ? '@vvjl/svg/vvjl-pattern-back.svg' : '@vvjl/svg/vvjl-pattern-prev.svg') }}<span class="vvjl-btn-text">{{ 'Previous'|t }}</span>
      </button>
      <button type="button" class="button modal-next control-btn">
        {{ include(vvjl_arrows ? '@vvjl/svg/vvjl-pattern-forward.svg' : '@vvjl/svg/vvjl-pattern-next.svg') }}<span class="vvjl-btn-text">{{ 'Next'|t }}</span>
      </button>
      {% if vvjl_rail %}
      <div class="vvjl-rail vvjl-rail-{{ vvjl_rail }}" role="group" aria-label="{{ 'Choose an image'|t }}">
        {% for key, row in rows %}
          <button type="button" class="vvjl-rail-btn control-btn" data-vvjl-index="{{ loop.index0 }}">
            <span class="visually-hidden">{{ 'Show image @index of @total'|t({'@index': loop.index, '@total': total_slides}) }}</span>
            {% if vvjl_rail == 'numbers' %}<span class="vvjl-rail-num" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>{% elseif vvjl_rail == 'segments' %}<span class="vvjl-seg" aria-hidden="true"></span>{% else %}<span class="vvjl-rail-thumb" aria-hidden="true"></span>{% endif %}
          </button>
        {% endfor %}
      </div>
      {% endif %}
      {% else %}
      <button class="button modal-prev control-btn">
        <span class="visually-hidden">{{ 'Previous'|t }}</span>
        {{ include('@vvjl/svg/svg-prev.svg') }}
      </button>
      <button class="button modal-next control-btn">
        <span class="visually-hidden">{{ 'Next'|t }}</span>
        {{ include('@vvjl/svg/svg-next.svg') }}
      </button>
      {% endif %}
    </div>

    {% for key, row in rows %}
      {% set row_content = row.content|render %}
      {% set split_content = row_content|split('<div class="vvjl-separator"></div>') %}
      {% set image_field = split_content[0] %}
      {% set foreground_field = split_content[1]|default('') %}

      <div id="{{ vvjl_id ~ '-' ~ (key + 1) }}" class="lightbox-row {{ options.animation }}" role="group" aria-labelledby="{{ vvjl_id }}-slide-{{ key + 1 }}-heading">

        <h3 id="{{ vvjl_id }}-slide-{{ key + 1 }}-heading" class="visually-hidden">{{ 'Slide @index of @total'|t({'@index': loop.index, '@total': total_slides}) }}</h3>

        <div class="lightbox-image">
          <button class="button modal-open control-btn" aria-controls="{{ lightbox_inner_id }}" aria-expanded="false" aria-label="{{ 'Expand slide @index'|t({'@index': loop.index}) }}">
            {{ include(vvj_pattern ? '@vvjl/svg/vvjl-pattern-expand.svg' : '@vvjl/svg/svg-expand.svg') }}
          </button>
          {{ image_field|safe_html }}
        </div>

        {% if foreground_field|render|striptags|trim %}
          <div class="lightbox-content" {% if background_rgb and not options.disable_overlay %} style="--bg-color:{{ background_rgb }}"{% endif %}>
            {{ foreground_field|safe_html }}
          </div>
        {% endif %}

      </div>
    {% endfor %}

  </div>
</vvjl-lightbox>
